{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 5,
  "stake_currency": "USDT",
  "stake_amount": 25,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "15m",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "leverage": 3,

  "strategy": "",
  "unfilledtimeout": {
    "entry": 2,
    "exit": 5,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },

  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0
  },

  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },

  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": { "enableRateLimit": true },
    "ccxt_async_config": { "enableRateLimit": true },
    "options": { "defaultType": "future" },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "AVAX/USDT:USDT",
      "FHE/USDT:USDT"
    ]
  },

  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],

  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "trailing_stop_loss": true
  },

  "telegram": {
    "enabled": true,
    "token": "7212044447:AAEDgyAPVIdFg5cltb1TEFUM2VkYzVs_QaU",
    "chat_id": "1042262874",
    "allowed_telegram_user_ids": [1042262874],
    "use_caption": true
  },

  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "jwt_secret_key": "eed20dc8b80903e8f914ac6ce73a41738f2b2edfebed4fdc627a11cd1ff70be7",
    "ws_token": "A8zdlUtn3FK4V6mFvypmORpNbYrrG40frg",
    "username": "freqtrader",
    "password": "Joshi2012",
    "enable_openapi": true
  },

  "bot_name": "BinanceFutures-Conservative",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  },

  "freqai": {
    "enabled": true,
    "activate_tensorboard": false,
    "purge_old_models": 2,
    "train_period_days": 15,
    "backtest_period_days": 30,
    "identifier": "unique-id",
    "feature_parameters": {
      "include_timeframes": ["15m", "1h"],
      "include_corr_pairlist": ["BTC/USDT", "ETH/USDT"],
      "label_period_candles": 20,
      "include_shifted_candles": 2,
      "DI_threshold": 0.9,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "indicator_periods_candles": [10, 20]
    },
    "data_split_parameters": {
      "test_size": 0,
      "random_state": 1
    },
    "model_training_parameters": {
      "n_estimators": 800
    }
  }
}